# Copy to .env for local development. On your host, set these as environment variables.

# "production" turns on HTTPS enforcement and strict checks; leave unset locally
APP_ENV=development

# Long random string, e.g. python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# At least 10 characters in production
ADMIN_PASSWORD=change-me

# Comma-separated sites allowed to call the API (https:// only in production)
CORS_ORIGINS=http://localhost:4200

# Leave unset to use the local SQLite file; set to a Postgres URL in production
# DATABASE_URL=postgresql://user:password@host:5432/portfolio

# Admin login lifetime in hours
TOKEN_LIFETIME_HOURS=12

PORT=5001
